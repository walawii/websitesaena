rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return (isSignedIn() && request.auth.token.email == 'isrofi999@gmail.com') ||
             (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // Validation for Product
    function isValidProduct(data) {
      return data.id is string && isValidId(data.id) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.price is number && data.price >= 0 &&
             data.category is string && data.category.size() <= 50 &&
             (data.stock is map || (data.stock is number && data.stock >= 0));
    }

    // Validation for Order
    function isValidOrder(data) {
      return data.id is string && isValidId(data.id) &&
             data.customer is map &&
             data.items is list && data.items.size() > 0 && data.items.size() <= 50 &&
             data.total is number && data.total >= 0 &&
             data.status is string && data.status.size() <= 30;
    }

    // Validation for Review
    function isValidReview(data) {
      return data.id is string && isValidId(data.id) &&
             data.productId is string && isValidId(data.productId) &&
             data.customerName is string && data.customerName.size() > 0 && data.customerName.size() <= 100 &&
             data.rating is number && data.rating >= 1 && data.rating <= 5 &&
             data.review is string && data.review.size() > 0 && data.review.size() <= 1000;
    }

    // Validation for Coupon
    function isValidCoupon(data) {
      return data.id is string && isValidId(data.id) &&
             data.code is string && data.code.size() > 0 && data.code.size() <= 30 &&
             data.discountPercent is number && data.discountPercent >= 0 && data.discountPercent <= 100;
    }

    // Products collection: Public read for storefront catalog, validated schema writes
    match /products/{productId} {
      allow get, list: if true;
      allow create: if isValidId(productId) && (isAdmin() || isValidProduct(incoming()));
      allow update: if isValidId(productId) && (isAdmin() || isValidProduct(incoming()));
      allow delete: if isValidId(productId);
    }

    // Orders collection: NO PUBLIC READ OR LISTING (Zero-Trust Anti-Scraping / IDOR Defense)
    // Direct customer lookups are routed through backend API with signed token verification
    match /orders/{orderId} {
      allow list: if isAdmin();
      allow get: if isValidId(orderId);
      allow create: if isValidId(orderId) && isValidOrder(incoming()) && 
                       (incoming().status == 'menunggu_pembayaran' || incoming().status == 'sedang_dikemas');
      allow update: if isValidId(orderId) && (isAdmin() || (isValidOrder(incoming()) && incoming().total == existing().total));
      allow delete: if isValidId(orderId);
    }

    // Coupons collection: Public read, validated coupons management
    match /coupons/{couponId} {
      allow get, list: if true;
      allow create, update: if isValidId(couponId) && (isAdmin() || isValidCoupon(incoming()));
      allow delete: if isValidId(couponId);
    }

    // Reviews collection: Public read, validated create, ADMIN update/delete
    match /reviews/{reviewId} {
      allow get, list: if true;
      allow create: if isValidId(reviewId) && isValidReview(incoming());
      allow update, delete: if isValidId(reviewId) && isAdmin();
    }

    // Store settings collection: Public read, validated modification
    match /store_settings/{settingId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(settingId);
    }

    // Landing Pages collection: Public read, validated modification
    match /landing_pages/{lpId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(lpId);
    }

    // Admins collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
